# Ajouts à la fin du .env officiel de Supabase (supabase/docker/.env.example).
# Les variables Supabase standard (POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY,
# DASHBOARD_*, SECRET_KEY_BASE, VAULT_ENC_KEY, LOGFLARE_*, POOLER_*) sont générées par install-vps.sh.
# Ce fichier ne contient AUCUN secret réel : il est versionné.

DOMAINE=
ACME_EMAIL=
SITE_URL=
API_EXTERNAL_URL=
SUPABASE_PUBLIC_URL=
ADDITIONAL_REDIRECT_URLS=
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
JWT_EXPIRY=900

# SMTP transactionnel — Brevo (société française, données en UE). DPA à signer.
SMTP_ADMIN_EMAIL=ne-pas-repondre@
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=uniion

# Passerelle IA — Mistral AI (La Plateforme, hébergement UE). Contrat : zéro rétention, pas d'entraînement.
# Bascule possible : AI_PROVIDER=anthropic (clause UE à contractualiser).
AI_PROVIDER=mistral
AI_MODEL=mistral-large-latest
AI_MODEL_ALIAS=unii-v1
AI_API_KEY=
QUOTA_IA_JOUR=150

# Chiffrement applicatif (32 octets base64). Générée une fois. À conserver HORS du VPS.
COFFRE_CLE_MAITRE=
SANTE_JETON=
FILE_JETON=
# Ouverture d'organisation (éditeur uniquement, console super-admin)
OUVERTURE_JETON=

# Diffusions aux adhérents — API transactionnelle Brevo (domaine expéditeur authentifié SPF/DKIM/DMARC)
BREVO_API_KEY=
EXPEDITEUR_EMAIL=
EXPEDITEUR_NOM=uniion

# Sauvegardes — dépôt restic chez un AUTRE fournisseur que l'hébergeur du VPS.
RESTIC_REPOSITORY=s3:https://s3.fr-par.scw.cloud/uniion-sauvegardes
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HOTE_SAUVEGARDE=uniion-prod
# Supervision (infra/supervision/SONDES.md) — URL des moniteurs « push » d'Uptime Kuma
KUMA_PUSH_SAUVEGARDE=
KUMA_PUSH_DISQUE=
ALERTE_URL=
