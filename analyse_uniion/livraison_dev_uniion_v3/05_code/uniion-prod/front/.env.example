# Seule la clé « anon » est publique. La clé service_role ne doit JAMAIS apparaître côté front
# (la CI échoue si elle est trouvée dans le bundle).
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# Clé publique Ed25519 de l'éditeur (base64, 32 octets) : vérifie la signature des extensions du registre.
VITE_EXT_CLE_PUBLIQUE=
